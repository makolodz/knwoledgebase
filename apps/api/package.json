{
  "name": "@encheres/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/server.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed-run.ts",
    "load:prepare": "tsx --env-file-if-exists=../../.env src/scripts/load-bids-run.ts prepare",
    "load:verify": "tsx --env-file-if-exists=../../.env src/scripts/load-bids-run.ts verify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@encheres/shared": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@trpc/server": "catalog:",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "mongoose": "^9.12.0",
    "nodemailer": "^10.3.1",
    "sharp": "^0.35.5",
    "socket.io": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "mongodb-memory-server": "^11.3.0",
    "socket.io-client": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
