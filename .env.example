# Copier ce fichier en `.env` (jamais versionné). Les valeurs ci-dessous sont les défauts de
# développement : l'API démarre aussi sans `.env`.
# Procédure complète : docs/runbooks/local-development.md

# --- API (apps/api, validées par src/config/env.ts) ---
NODE_ENV=development
HOST=localhost
PORT=3000
# Seule origine autorisée par CORS et Socket.IO : schéma + hôte + port, sans barre finale.
WEB_ORIGIN=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Base MongoDB. Défaut : celle de docker-compose.yml (`pnpm infra:up`). Obligatoire en production.
# Peut contenir des identifiants : jamais affichée ni journalisée.
MONGO_URL=mongodb://127.0.0.1:27017/encheres

# Emails : Mailpit en développement (interface sur http://localhost:8025), Brevo en production.
# SMTP_HOST et SMTP_FROM sont obligatoires en production. SMTP_USER et SMTP_PASSWORD vont
# ensemble (laisser commentés pour Mailpit) et ne partent jamais sans TLS.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Enchères <no-reply@encheres.local>
# SMTP_USER=
# SMTP_PASSWORD=

# --- Front (apps/web) ---
# Visible du navigateur : jamais de secret dans une variable VITE_*.
# Origine de l'API (HTTP et Socket.IO), sans barre finale.
VITE_API_URL=http://localhost:3000

# --- Variables des étapes suivantes (pas encore lues par le code) ---
# Jamais de vraie valeur dans ce fichier : seuls les noms et des exemples locaux.
# JWT_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# UPLOAD_DIR=./uploads
